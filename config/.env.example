# =============================================================================
# REVARIE LM V1.0 – ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file!

# -----------------------------------------------------------------------------
# Cloudflare D1 (Vault) – Structured Data
# -----------------------------------------------------------------------------
VAULT_API_URL=https://revarie-vault-api.workers.dev
VAULT_API_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Cloudflare Vectorize – Vector Database
# -----------------------------------------------------------------------------
VECTORIZE_API_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/vectorize/v2/indexes/INDEX_ID
VECTORIZE_API_TOKEN=your-cf-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# -----------------------------------------------------------------------------
# Hugging Face
# -----------------------------------------------------------------------------
HF_TOKEN=hf_your_token_here
HF_SPACE_URL=https://revarie-lm-v1-engine.hf.space

# -----------------------------------------------------------------------------
# Groq API Keys (8 keys per pool – comma separated)
# -----------------------------------------------------------------------------
# Reasoning Models
GROQ_REASONING_120B_KEYS=key1,key2,key3,key4,key5,key6,key7,key8
GROQ_REASONING_20B_KEYS=key1,key2,key3,key4,key5,key6,key7,key8

# Social Interactive Models
GROQ_SOCIAL_70B_KEYS=key1,key2,key3,key4,key5,key6,key7,key8
GROQ_SOCIAL_SCOUT_KEYS=key1,key2,key3,key4,key5,key6,key7,key8

# Memory Recall Models
GROQ_MEMORY_INSTANT_KEYS=key1,key2,key3,key4,key5,key6,key7,key8
GROQ_MEMORY_QWEN_KEYS=key1,key2,key3,key4,key5,key6,key7,key8

# Safety & Regulation Models
GROQ_SAFETY_SAFEGUARD_KEYS=key1,key2,key3,key4,key5,key6,key7,key8
GROQ_SAFETY_GUARD_86M_KEYS=key1,key2,key3,key4,key5,key6,key7,key8
GROQ_SAFETY_GUARD_22M_KEYS=key1,key2,key3,key4,key5,key6,key7,key8

# -----------------------------------------------------------------------------
# Cerebras API Keys (8 keys per pool)
# -----------------------------------------------------------------------------
CEREBRAS_QWEN_235B_KEYS=key1,key2,key3,key4,key5,key6,key7,key8
CEREBRAS_LLAMA_8B_KEYS=key1,key2,key3,key4,key5,key6,key7,key8

# -----------------------------------------------------------------------------
# Gemini API Keys (2 keys per pool)
# -----------------------------------------------------------------------------
GEMINI_FLASH_KEYS=key1,key2
GEMINI_FLASH_LITE_KEYS=key1,key2

# -----------------------------------------------------------------------------
# Kaggle (for nightly training)
# -----------------------------------------------------------------------------
KAGGLE_USERNAME=your-username
KAGGLE_KEY=your-kaggle-api-key

# -----------------------------------------------------------------------------
# DigitalOcean (AMD MI300X Training)
# -----------------------------------------------------------------------------
DO_API_TOKEN=your-do-token
DO_SSH_KEY_FINGERPRINT=your-ssh-fingerprint

# -----------------------------------------------------------------------------
# Cron‑Job.org
# -----------------------------------------------------------------------------
CRONJOB_API_KEY=your-cronjob-api-key

# -----------------------------------------------------------------------------
# Vercel
# -----------------------------------------------------------------------------
VERCEL_TOKEN=your-vercel-token
NEXT_PUBLIC_HF_SPACE_URL=https://revarie-lm-v1-engine.hf.space
