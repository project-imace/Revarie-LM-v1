FROM rocm/pytorch:rocm6.1_ubuntu22.04_py3.10_pytorch_2.4.0

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    vim \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir \
    deepspeed \
    flash-attn \
    wandb \
    huggingface_hub

# Copy training scripts
COPY train_persona_lora.py .
COPY prepare_samara_dataset.py .
COPY prepare_artery_dataset.py .
COPY export_to_onnx.py .

# Set environment variables for ROCm
ENV HSA_OVERRIDE_GFX_VERSION=9.4.2
ENV ROCM_PATH=/opt/rocm
ENV LD_LIBRARY_PATH=/opt/rocm/lib:$LD_LIBRARY_PATH

ENTRYPOINT ["python", "train_persona_lora.py"]
