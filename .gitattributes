# Auto detect text files and perform LF normalization
* text=auto

# Specific file types
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.rs text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.lisp text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.onnx binary
*.safetensors binary
*.bin binary
*.pt binary
*.pth binary
*.pdf binary

# Linguist overrides (GitHub language stats)
*.ipynb linguist-language=Jupyter-Notebook
*.lisp linguist-language=Common-Lisp
*.asd linguist-language=Common-Lisp
